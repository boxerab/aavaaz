FROM dustynv/l4t-pytorch:r36.2.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git build-essential portaudio19-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY aavaaz/ aavaaz/

# the l4t base already ships a CUDA torch

# pypi whisper-live lacks the transcript_finalizer hook aavaaz serve passes
ARG WHISPER_LIVE_SOURCE=git+https://github.com/boxerab/WhisperLive@scaling-fixes
RUN pip install --no-cache-dir "$WHISPER_LIVE_SOURCE" && \
    pip install --no-cache-dir .[whisper-cpu]

EXPOSE 9090 8000 9100

ENTRYPOINT ["aavaaz", "serve"]
CMD ["--model", "small"]
